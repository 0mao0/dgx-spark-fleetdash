# fleetdash 机上现场值模板 —— 仓库永不存真值。
# 用法：复制为 ~/fleetdash/.env（600）并填真值；systemd 服务可用
#   EnvironmentFile=-/home/<user>/fleetdash/.env
# 或直接在 unit/override 里写 Environment=。缺省链见 README「安全」。

# 企微群机器人 webhook（edge 告警/日报用；也可用 --webhook-file 指文件，如 /etc/fleetdash/webhook）
FLEETDASH_WEBHOOK=

# 引擎 /metrics 鉴权 key（collector 抓 LLM 指标用；引擎无鉴权则留空）
FLEETDASH_VLLM_KEY=

# 电源操作 token（页面关机/重启门控；缺省读 ~/fleetdash/power.token，600）
#FLEETDASH_POWER_TOKEN=

# systemd 户口名单文件（server 端；缺省 ~/fleetdash/units.json，见 units.example.json）
#FLEETDASH_UNITS_FILE=

# edge 的 peers 热加载文件（缺省 /etc/fleetdash/peers.json，见 peers.example.json）
#FLEETDASH_PEERS_FILE=
